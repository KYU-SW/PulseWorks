DATABASE_URL=postgresql+psycopg2://emr:emr@db:5432/emr
JWT_SECRET=dev-secret-change-me

# Narrative Provider 기반(향후 실제 LLM 연결용) - 기본값 mock을 벗어나지
# 않는 한 아래 LLM_* 값은 전혀 쓰이지 않는다. 실제 키는 여기에 절대
# 넣지 않는다.
NARRATIVE_PROVIDER=mock

# LLM_VENDOR: 현재 지원하는 값은 "ollama"뿐이다(로컬 실행, API 키 불필요).
# 비워두면(또는 지원하지 않는 값이면) NARRATIVE_PROVIDER=llm이 명확한
# 설정 오류로 실패한다 - 빈 값을 ollama로 추측해서 넘어가지 않는다.
LLM_VENDOR=

# LLM_BASE_URL: 벤더 API 주소. 값은 backend를 어떻게 실행하는지에
# 따라 달라진다(DATABASE_URL과 같은 패턴) - 이 파일에는 예시로 호스트
# 직접 실행용 값을 적어둔다. Docker Compose로 backend를 띄우면
# docker-compose.yml이 이 값을 http://host.docker.internal:11434로
# 덮어쓴다(Ollama는 Windows 호스트에서 네이티브로 실행되고, 컨테이너
# 안에서 "localhost"는 컨테이너 자기 자신이기 때문).
#   Docker backend:        http://host.docker.internal:11434
#   호스트에서 backend 직접 실행: http://localhost:11434
LLM_BASE_URL=http://localhost:11434

# LLM_API_KEY: 향후 상용 provider(API 키가 필요한 벤더)를 위해 이
# placeholder를 유지한다. LLM_VENDOR=ollama일 때는 API 키가 필요
# 없으므로 비워둘 수 있다.
LLM_API_KEY=

# LLM_MODEL 예시: Ollama라면 로컬에 설치된 모델명(예: qwen3:8b)을 쓴다.
LLM_MODEL=

LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1000
